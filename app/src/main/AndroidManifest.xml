<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- AAOS 표준: 기어(GEAR_SELECTION) 읽기 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- Pleos Vehicle SDK: 쪽잠 세팅에 쓰는 기능만 선언 (사용하는 API에 필요한 최소 권한) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />

    <!-- Pleos NaviHelper SDK: 목적지·현재 위치 조회, 경유지 추가 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- Pleos TextToSpeech / SpeechToText SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application
        android:name=".ShimpyoApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_shimpyo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shimpyo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <!-- screenOrientation을 지정하지 않음: Pleos는 기본 세로 창(한 칸), 사용자가 넓히면 가로 창(두 칸).
                 화면은 두 경우 모두 대응하고, 창 크기·낮밤이 바뀌어도 액티비티를 다시 만들지 않는다 -->

            <!-- 주행 중에도 최소 화면(큰 글씨 한 줄 + 음성)을 띄우기 위한 선언 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
